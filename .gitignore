# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/
*.user
*.suo
*.sln

# OS
.DS_Store
Thumbs.db

# Environment
.env

# Outputs & training runs
outputs/
runs/

# Media files
*.mp4
*.avi
*.mov
*.mkv

# Ignore CSV except results/
*.csv
!results/**/*.csv

# Ignore JSON except static app files, results/ and evaluation annotations
*.json
!frontend/static/manifest.json
!results/**/*.json
!scripts/littering_annotations.json

# datasets / big files
datasets/
TACO/
UAVVaste/

# Model weights
*.pt

# Web app runtime artifacts
backend/trash_detection.db
backend/trashdet.db
backend/uploads/
backend/annotated/
backend/videos/
backend/avatars/
backend/photos/

# Littering evidence (clips + thumbnails — generated at runtime)
backend/littering/*.mp4
backend/littering/*.jpg
backend/littering/*.png

# Test videos — downloaded at runtime, not committed
datasets/test_videos/

# Claude internal
.claude/scheduled_tasks.lock

# Temporary files
tmp/

# Tunneling tools & logs
*.exe
*.zip
*.log
ngrok/
cloudflared*
pinggy*
