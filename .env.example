# TrashDetectionSystem — Environment Configuration
# Copy this file to .env and customize values.

# JWT secret (MUST change locally — generate with: py -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Public URL used by the frontend and generated report links.
APP_BASE_URL=http://localhost:8000

# Model weights (relative to repo root)
DETECTOR_WEIGHTS=models/detector/production/best.pt
CLASSIFIER_WEIGHTS=models/classify/B2/best.pt
PERSON_DETECTOR_WEIGHTS=models/pretrained/yolov8n.pt

# Database (leave empty for default SQLite)
DATABASE_URL=

# Runtime media storage, relative to repo root
STORAGE_ROOT=data/runtime

# Upload limits in MB
MAX_UPLOAD_MB=20
VIDEO_MAX_UPLOAD_MB=200

# Inference/runtime defaults
LIVE_IMGSZ=640
DEFAULT_DET_CONF=0.30
MONITOR_MIN_DET_CONF=0.35
MONITOR_TARGET_FPS=15
MONITOR_CAMERA_WIDTH=1280
MONITOR_CAMERA_HEIGHT=720
MONITOR_CAPTURE_MAX_DIM=768
MONITOR_JPEG_QUALITY=0.75
MONITOR_TRASH_IMGSZ=768
MONITOR_PERSON_IMGSZ=416

# Evidence retention for local/server deployments
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_INTERVAL_HOURS=24
LITTERING_FILE_RETENTION_DAYS=30
